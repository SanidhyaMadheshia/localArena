{
  "realm": "localarena",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "player", "description": "Can play and buy cosmetics" },
      { "name": "admin", "description": "Can ban players" }
    ]
  },
  "defaultRoles": ["player"],
  "clients": [
    {
      "clientId": "localarena-web",
      "name": "LocalArena browser client",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/*", "https://localhost:8443/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:8080", "https://localhost:8443", "http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "protocolMappers": [
        {
          "name": "audience-localarena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "localarena-api", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "localarena-bots",
      "name": "Load-test bots (lab only: password grant)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-localarena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "localarena-api", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "localarena-api",
      "name": "API resource server (audience only)",
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Player",
      "credentials": [{ "type": "password", "value": "alice-dev-password", "temporary": false }],
      "realmRoles": ["player"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Player",
      "credentials": [{ "type": "password", "value": "bob-dev-password", "temporary": false }],
      "realmRoles": ["player"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "email": "admin1@example.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin1-dev-password", "temporary": false }],
      "realmRoles": ["player", "admin"]
    }
  ]
}
