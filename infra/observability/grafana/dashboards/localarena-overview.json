{
 "uid": "localarena-overview",
 "title": "LocalArena overview",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "localarena"
 ],
 "panels": [
  {
   "type": "row",
   "title": "SLOs",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Availability error ratio (5m) vs 0.5% SLO",
   "datasource": {
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "slo:api_errors:ratio_rate5m",
     "legendFormat": "5m",
     "refId": "A"
    },
    {
     "expr": "slo:api_errors:ratio_rate1h",
     "legendFormat": "1h",
     "refId": "B"
    },
    {
     "expr": "vector(0.005)",
     "legendFormat": "SLO",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Requests slower than 300 ms vs 1% SLO",
   "datasource": {
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "slo:api_slow:ratio_rate5m",
     "legendFormat": "5m",
     "refId": "A"
    },
    {
     "expr": "vector(0.01)",
     "legendFormat": "SLO",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Ticks over 50 ms vs 0.1% SLO",
   "datasource": {
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "slo:ticks_slow:ratio_rate5m",
     "legendFormat": "5m",
     "refId": "A"
    },
    {
     "expr": "vector(0.001)",
     "legendFormat": "SLO",
     "refId": "B"
    }
   ]
